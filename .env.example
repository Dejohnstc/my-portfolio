# Copy this file to .env and fill in the values. Set the same values in Vercel → Settings → Environment Variables.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/obiresoffice?retryWrites=true&w=majority
ADMIN_KEY=<a long secret password for /admin>

# Email alerts for new reviews (Gmail → Security → 2-Step Verification → App passwords)
GMAIL_USER=obiresoffice@gmail.com
GMAIL_APP_PASSWORD=<16-character app password>
# Optional: send alerts to a different address
NOTIFY_EMAIL=
